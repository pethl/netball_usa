<% content_for(:page_title, "System Users")%>

<div class="px-2">
  <div id="users">

    <div class="mb-2 flex justify-end gap-4">
      <%= link_to "Create user account", new_admin_user_path,
      class: "inline-flex items-center rounded-md bg-blue-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-800" %>

      <%= link_to "Manage user groups",
      user_groups_path,
      class: clear_button_class %>
    </div>

    <% headers = ["First Name", "Last Name", "Email", "Created", "Last Sign In", "Role", "Is_admin?", "Is_active?", "[:Id]"] %>

    <div>

      <%= render partial: "user_table",
      locals: {
        title: "Administrators",
        users: @admin_users,
        headers: headers,
        include_confirmation: false,
        include_active?: true
      } %>

      <%= render partial: "user_table",
      locals: {
        title: "Office",
        users: @office_users,
        headers: headers,
        include_confirmation: false,
        include_active?: true
      } %>

      <%= render partial: "user_table",
      locals: {
        title: "NA People",
        users: @na_people,
        headers: headers,
        include_confirmation: false,
        include_active?: true
      } %>

      <%= render partial: "user_table",
      locals: {
        title: "Team Leads",
        users: @team_leads,
        headers: headers,
        include_confirmation: false,
        include_active?: true
      } %>
    </div>

    <hr class="my-4">

    <div class="m-4 text-sm text-gray-700"><br>
      <strong>[OFFICE USE ONLY]</strong>
      <strong>      User Role Definitions:</strong>
      <ul class="mt-2 list-disc ml-6 space-y-1">
        <li>0 : admin (everything)</li>
        <li>4 : office (role specific access + own person + events</li>
        <li>2 : NA People (own person record and own US Open travel details only</li>
        <li>3 : Team Leads (club and members) NO LONGER IN USE</li>
      </ul>

      <p class="mt-2">All roles have access to create Educator</p>

    </div>
  </div>
</div>
