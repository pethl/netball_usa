<% content_for(:page_title, "Office User Access Report") %>

<div class="px-2 space-y-8">
  <div class="flex flex-wrap items-center justify-between gap-4 pt-4">
    <p class="text-sm text-gray-600">
      Role 4 (office) users only. Locked accounts remain visible and are clearly marked.
    </p>

    <div>
      <%= link_to "Download PDF",
                  access_report_users_path(format: :pdf),
                  class: form_button_class %>
    </div>
  </div>

  <%= render "admin_nav" %>

  <section>
    <h2 class="mb-2 text-xl font-semibold text-blue-900">Access for every office user</h2>
    <p class="mb-3 text-sm text-gray-600">
      These are restricted to the signed-in user’s own linked records. They do not provide list access.
    </p>

    <div class="overflow-x-auto">
      <table class="w-full table-fixed text-left text-sm">
        <thead class="bg-gray-200 text-gray-700">
          <tr>
            <th class="w-1/3 px-3 py-2">Model / area</th>
            <th class="px-3 py-2">Access</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% OfficeAccessReport::UNIVERSAL_ACCESS.each do |model_name, access_level| %>
            <tr>
              <td class="px-3 py-2 font-medium"><%= model_name %></td>
              <td class="px-3 py-2"><%= access_level %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2 class="mb-2 text-xl font-semibold text-blue-900">Selected access by model</h2>
    <p class="mb-3 text-sm text-gray-600">
      Calculated from each user’s current CanCanCan permissions. Admin-only areas such as Ref Data and Audit are excluded.
    </p>

    <div class="overflow-x-auto">
      <table class="w-full table-fixed text-left text-sm">
        <thead class="bg-gray-200 text-gray-700">
          <tr>
            <th class="w-1/4 px-3 py-2">Model / area</th>
            <th class="w-1/4 px-3 py-2">Access</th>
            <th class="px-3 py-2">Office users</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @access_report.by_model.each do |entry| %>
            <tr class="align-top">
              <td class="px-3 py-2 font-medium"><%= entry.model_name %></td>
              <td class="px-3 py-2"><%= entry.access_level %></td>
              <td class="px-3 py-2">
                <div class="flex flex-wrap gap-2">
                  <% entry.users.each do |user| %>
                    <span class="rounded-full bg-blue-100 px-2 py-1 text-xs text-blue-900">
                      <%= user.full_name %><%= " · Locked" unless user.account_active? %>
                    </span>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2 class="mb-3 text-xl font-semibold text-blue-900">Access by office user</h2>

    <div class="space-y-5">
      <% @access_report.by_user.each do |entry| %>
        <div class="rounded border border-gray-200 p-4">
          <div class="mb-3 flex flex-wrap items-start justify-between gap-2">
            <div>
              <h3 class="text-xl font-bold text-blue-900">
                <%= entry.user.full_name %>
                <span class="text-base font-normal text-gray-600">(role: <%= entry.user.role %>)</span>
              </h3>
              <p class="text-xs text-gray-600"><%= entry.user.email %></p>
            </div>
            <span class="rounded-full px-2 py-1 text-xs <%= entry.user.account_active? ? 'bg-green-100 text-green-900' : 'bg-gray-200 text-gray-700' %>">
              <%= entry.user.account_active? ? "Active" : "Locked" %>
            </span>
          </div>

          <p class="mb-3 text-sm">
            <strong>Groups:</strong>
            <%= entry.groups.any? ? entry.groups.map(&:name).join(", ") : "None" %>
          </p>

          <% if entry.access.any? %>
            <ul class="grid gap-1 text-sm md:grid-cols-2">
              <% entry.access.each do |access| %>
                <li><strong><%= access.model_name %>:</strong> <%= access.access_level %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-600">No selected access; universal own-record access only.</p>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</div>
