<% content_for(:page_title, "User groups") %>

<%= render "admin_nav" %>

<div class="mx-auto max-w-4xl px-4 py-8">
  <div class="rounded-lg bg-white p-6 shadow">
    <div class="mb-6 border-b border-gray-200 pb-4">
      <h1 class="text-2xl font-bold text-gray-900">
        Groups for <%= @user.full_name %>
      </h1>

      <p class="mt-1 text-sm text-gray-600">
        <%= @user.email %>
      </p>

      <div class="mt-3 flex flex-wrap gap-3 text-sm">
        <span class="rounded bg-gray-100 px-3 py-1 text-gray-700">
          Role: <%= @user.role.humanize %>
        </span>

        <span class="rounded px-3 py-1 <%= @user.account_active? ? "bg-green-100 text-green-800" : "bg-gray-200 text-gray-700" %>">
          <%= @user.account_active? ? "Active" : "Locked" %>
        </span>
      </div>
    </div>

    <%= form_with url: update_groups_user_path(@user),
          method: :patch do %>

      <fieldset>
        <legend class="text-lg font-semibold text-gray-900">
          Group membership
        </legend>

        <p class="mt-1 text-sm text-gray-600">
          Select every group this user should belong to.
        </p>

        <% if @user_groups.any? %>
          <div class="mt-5 space-y-3">
            <% @user_groups.each do |user_group| %>
              <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-gray-200 p-4 hover:bg-gray-50">
                <%= check_box_tag "user[user_group_ids][]",
                      user_group.id,
                      @selected_group_ids.include?(user_group.id),
                      class: "mt-1 rounded border-gray-300 text-blue-900" %>

                <span>
                  <span class="block font-medium text-gray-900">
                    <%= user_group.name %>
                  </span>

                  <% if user_group.description.present? %>
                    <span class="mt-1 block text-sm text-gray-600">
                      <%= user_group.description %>
                    </span>
                  <% end %>

                  <span class="mt-1 block text-xs text-gray-500">
                    Key: <%= user_group.key %>
                  </span>
                </span>
              </label>
            <% end %>
          </div>
        <% else %>
          <p class="mt-4 text-gray-500">
            No active user groups are available.
          </p>
        <% end %>
      </fieldset>

      <div class="mt-8 flex justify-end gap-3 border-t border-gray-200 pt-5">
        <%= link_to "Back to users",
              users_path,
              class: clear_button_class %>

        <%= submit_tag "Save group membership",
              class: form_button_class %>
      </div>
    <% end %>
  </div>
</div>
