<div class="mt-6 text-2xl font-semibold text-blue-900"><%= title %></div>

<%
  active_users = users.select(&:account_active?)
  locked_users = users.reject(&:account_active?)
  ordered_users = active_users + locked_users
  locked_heading_shown = false
%>

<div class="space-y-3 md:hidden">
  <% locked_heading_shown = false %>
  <% ordered_users.each do |user| %>
    <% if !user.account_active? && !locked_heading_shown %>
      <div class="border-y border-gray-300 bg-gray-100 px-3 py-2 text-sm font-semibold text-gray-600">
        Locked accounts
      </div>

      <% locked_heading_shown = true %>
    <% end %>

    <article class="overflow-hidden rounded-lg border border-gray-200 shadow-sm <%= user.account_active? ? 'bg-white' : 'bg-gray-100' %>">
      <div class="flex items-start justify-between gap-3 border-b border-gray-200 px-4 py-3">
        <div>
          <div class="font-semibold text-gray-900"><%= user.first_name %> <%= user.last_name %></div>
          <div class="mt-1 break-all text-sm">
            <%= link_to user.email,
                  profile_user_path(user),
                  class: link_class,
                  title: "Link this user to a Person profile" %>

            <% if user.person.present? %>
              <i class="fa-solid fa-link ml-1 text-xs text-green-600"
                 title="Linked to Person ID <%= user.person.id %>"
                 aria-label="Linked to a Person profile"></i>
            <% end %>
          </div>
        </div>

        <span class="shrink-0 rounded-full px-4 py-1 text-xs font-semibold <%= user.account_active? ? 'bg-green-100 text-green-800' : 'bg-gray-200 italic text-gray-700' %>">
          <%= user.account_active? ? 'Active' : 'Locked' %>
        </span>
      </div>

      <dl class="grid grid-cols-2 gap-x-4 gap-y-3 px-4 py-3 text-sm">
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">First Name</dt>
          <dd class="mt-0.5 text-gray-900"><%= user.first_name %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Last Name</dt>
          <dd class="mt-0.5 text-gray-900"><%= user.last_name %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Created</dt>
          <dd class="mt-0.5 text-gray-900">
            <span class="block"><%= user.created_at.strftime("%b %d,") %></span>
            <span class="block"><%= user.created_at.strftime("%y") %></span>
          </dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Last Sign In</dt>
          <dd class="mt-0.5 text-gray-900">
            <% if user.last_sign_in_at.present? %>
              <span class="block"><%= user.last_sign_in_at.strftime("%b %d,") %></span>
              <span class="block"><%= user.last_sign_in_at.strftime("%y") %></span>
            <% end %>
          </dd>
        </div>
        <div class="text-right">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500 ">Role</dt>
          <dd class="mt-0.5 break-words text-gray-900 text-right"><%= user.role %></dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">User ID</dt>
          <dd class="mt-0.5 text-gray-900"><%= user.id %></dd>
        </div>
        <div class="col-span-2">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Groups</dt>
          <dd class="mt-0.5 text-gray-900">
            <% if user.user_groups.any? %>
              <%= user.user_groups.sort_by(&:name).map(&:name).to_sentence %>
            <% else %>
              <span class="text-gray-500">None</span>
            <% end %>
          </dd>
        </div>
      </dl>

      <div class="border-t border-gray-200 px-4 py-3">
        <% if user.account_active? %>
          <%= button_to "Email reset link",
              send_password_reset_admin_user_path(user),
              method: :post,
              form: { class: "w-full" },
              class: "w-full rounded-md bg-blue-900 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-800",
              data: { turbo_confirm: "Send a password reset email to #{user.email}?" } %>
        <% else %>
          <span class="block text-center text-xs text-gray-600">Reactivate first</span>
        <% end %>
      </div>
    </article>
  <% end %>
</div>

<div class="hidden md:block">
  <table class="table-fixed h_scrolling_list_table w-full">
    <colgroup>
      <col style="width: 12%">
      <col style="width: 10%">
      <col style="width: 22%">
      <col style="width: 9%">
      <col style="width: 9%">
      <col style="width: 14%">
      <col style="width: 8%">
      <col style="width: 11%">
      <col style="width: 5%">
    </colgroup>

    <thead class="bg-gray-200 border-b text-gray-500 font-light text-xs">
      <tr>
        <th class="text-left p-2">First Name</th>
        <th class="text-left p-2">Last Name</th>
        <th class="text-left p-2 break-words">Email</th>
      <th class="p-2 text-center">Created</th>
      <th class="p-2 text-center">Last Sign In</th>
      <th class="p-2 text-right">Role</th>
        <th class="p-2 text-center">Active?</th>
        <th class="text-center p-2">Password</th>
        <th class="text-right p-2">[:Id]</th>
      </tr>
    </thead>

    <tbody>
      <% ordered_users.each do |user| %>
        <% if !user.account_active? && !locked_heading_shown %>
          <tr>
            <td colspan="9"
          class="border-y border-gray-300 bg-gray-100 px-3 py-2 text-left text-sm font-semibold text-gray-600">
              Locked accounts
            </td>
          </tr>

          <% locked_heading_shown = true %>
        <% end %>
        <% row_class = user.account_active? ? "hover:bg-gray-100" : "bg-gray-200" %>
        <tr class="<%= row_class %>">
          <td class="p-2 border-b text-left"><%= user.first_name %></td>
          <td class="p-2 border-b text-left"><%= user.last_name %></td>
          <td class="p-2 border-b text-left truncate">
            <%= link_to user.email,
                profile_user_path(user),
                class: link_class,
                title: "Link this user to a Person profile" %>

            <% if user.person.present? %>
              <i class="fa-solid fa-link ml-1 text-xs text-green-600"
               title="Linked to Person ID <%= user.person.id %>"
               aria-label="Linked to a Person profile"></i>
            <% end %>
          </td>
        <td class="border-b p-2 text-center"><%= user.created_at.to_formatted_s(:short_usa_year) %></td>
        <td class="border-b p-2 text-center"><%= user.last_sign_in_at&.to_formatted_s(:short_usa_year) %></td>
        <td class="border-b p-2 text-right break-words"><%= user.role %></td>
          <td class="p-2 border-b text-center <%= user.account_active? ? "" : "font-semibold italic" %>">
            <%= user.account_active? ? 'Active' : 'Locked' %>
          </td>

          <td class="p-2 border-b text-center">
            <% if user.account_active? %>
              <%= button_to "Email reset link",
                send_password_reset_admin_user_path(user),
                method: :post,
                form: { class: "inline" },
                class: "rounded-md bg-blue-900 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-blue-800",
                data: { turbo_confirm: "Send a password reset email to #{user.email}?" } %>
            <% else %>
              <span class="text-xs text-gray-600">Reactivate first</span>
            <% end %>
          </td>

          <td class="p-2 border-b text-right"><%= user.id %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
