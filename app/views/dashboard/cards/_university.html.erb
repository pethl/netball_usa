<%= link_to university_objectives_path,
      class: "group flex min-h-[200px] flex-col justify-between rounded-md border-b-4 border-gray-300 bg-blue-900 p-4 font-medium text-white shadow-lg transition-all duration-200 hover:scale-[1.01] hover:shadow-xl" do %>

  <!-- Top Section -->
  <div class="flex items-start justify-between">
    <div class="flex h-14 w-14 items-center justify-center rounded-full bg-white transition-all duration-300 group-hover:rotate-12">
      <i class="fa-solid fa-graduation-cap text-xl text-blue-800"></i>
    </div>

    <div class="text-right">
      <p class="text-xl font-bold leading-tight">
        USA UNI
      </p>

      <p class="mt-1 text-sm uppercase tracking-wide text-gray-200">
        Program
      </p>
    </div>
  </div>

  <!-- Statistics -->
  <div class="mt-4 space-y-1 text-sm text-blue-200">
    <div class="flex items-center justify-between gap-3">
      <span>Tasks</span>

      <span class="text-right font-semibold">
        Open <%= @university_tasks_open %>
        ·
        Complete <%= @university_tasks_complete %>
      </span>
    </div>

    <div class="flex items-center justify-between">
      <span>Partners</span>

      <span class="font-semibold">
        <%= @university_partners %>
      </span>
    </div>

    <div class="flex items-center justify-between">
      <span>Squad — Confirmed</span>

      <span class="font-semibold">
        <%= @university_confirmed_players %>
      </span>
    </div>

    <div class="flex items-center justify-between">
      <span>Future Players</span>

      <span class="font-semibold">
        <%= @university_future_players %>
      </span>
    </div>

    <div class="flex items-center justify-between">
      <span>Budget</span>
    </div>
  </div>
<% end %>