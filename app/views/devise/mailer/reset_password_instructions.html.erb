<div style="margin:0 auto;max-width:560px;font-family:Arial,sans-serif;color:#1f2937;line-height:1.6;">
  <div style="padding:20px;text-align:center;border-bottom:4px solid #173b73;">
    <%= image_tag asset_url("Netball_America_Logo.png"), alt: "Netball America", style: "max-width:180px;height:auto;" %>
  </div>

  <div style="padding:28px 24px;">
    <h1 style="margin:0 0 16px;color:#173b73;font-size:22px;">Reset your password</h1>
    <p>Hi <%= @resource.first_name.presence || @resource.email %>,</p>
    <p>We received a request to reset the password for your Netball America account.</p>

    <p style="margin:28px 0;text-align:center;">
      <%= link_to "Reset my password", edit_password_url(@resource, reset_password_token: @token), style: "display:inline-block;border-radius:6px;background:#173b73;color:#ffffff;padding:12px 22px;text-decoration:none;font-weight:bold;" %>
    </p>

    <p>This secure link expires in <%= distance_of_time_in_words(@resource.class.reset_password_within) %>. Your password will not change until you use the link and choose a new one.</p>
    <p style="font-size:13px;color:#6b7280;">If you did not request this reset, you can safely ignore this email. For account support, contact <%= mail_to "info@netballamerica.com" %>. For system-related issues, contact <%= mail_to "pethicklisa@gmail.com" %>.</p>

    <p>Regards,<br>Netball America</p>
  </div>
</div>
