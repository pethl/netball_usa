<% content_for(:page_title, "Donated Items") %>

<%= render "filter_nav" %>

<div class="my-4">
  <%= link_to "Add New Donated Item", new_donated_item_path, class: form_button_class %>
</div>

<% if @donated_items.any? %>
  <div id="donated_items">
    <div class="relative overflow-x-auto">
      <table class="w-full table-fixed ml-2 text-left rtl:text-right">
        <thead class="bg-gray-200 border-b text-gray-800 font-light text-xs">
          <tr>
            <th scope="col" class="px-4 py-2 w-40 text-center">
              Action
            </th>

            <th scope="col" class="px-4 py-2 w-64">
              Description
            </th>

            <th scope="col" class="px-4 py-2 w-40">
              Type
            </th>

            <th scope="col" class="px-4 py-2 w-28 text-right">
              Value
            </th>

            <th scope="col" class="px-4 py-2 w-32">
              Status
            </th>

            <th scope="col" class="px-4 py-2 w-32">
              Expiry Date
            </th>

            <th scope="col" class="px-4 py-2 w-48">
              Donated To
            </th>

            <th scope="col" class="px-4 py-2">
              Requirements
            </th>

          </tr>
        </thead>

        <tbody>
          <% @donated_items.each do |donated_item| %>
            <tr class="<%= donated_item.status.in?(%w[Approved Expired]) ? 'bg-gray-100' : 'bg-white' %> border-b hover:bg-gray-100 whitespace-nowrap">
            <td class="px-4 py-4 align-top whitespace-nowrap text-center">
                <% if donated_item.status == "Available" %>
                  <%= link_to "Request Item",
                        new_donated_item_request_path(donated_item_id: donated_item.id),
                        class: green_clear_button_class %>

                <% elsif donated_item.status == "Requested" && donated_item.latest_request.present? %>
                  <% if is_admin? %>
                    <%= link_to "Review Request",
                          donated_item_request_path(donated_item.latest_request),
                          class: yellow_clear_button_class %>
                  <% else %>
                    <span class="text-sm text-blue-700">
                      Requested by<br>
                      <strong><%= donated_item.latest_request.requested_by.full_name %></strong>
                    </span>
                  <% end %>

                <% elsif donated_item.status == "Approved" && donated_item.latest_request.present? %>
                  <span class="text-sm text-gray-500">
                    Approved for<br>
                    <strong><%= donated_item.latest_request.recipient_name %></strong>
                  </span>

                   <% elsif donated_item.status == "Expired" %>
                   <span class="text-sm text-gray-500">
                   <%= donated_item.status %>
                   
                  </span>
              
                <% end %>
              </td>

              <td class="align-top px-4 py-4 font-medium text-gray-800 whitespace-normal break-words max-w-[200px]">
                <%= link_to donated_item.description, donated_item_path(donated_item), class: link_class %>
              </td>

              <td class="px-4 py-4 align-top truncate">
                <%= donated_item.item_type %>
              </td>

              <td class="px-4 py-4 align-top truncate  text-right">
                <%= number_to_currency(donated_item.value, precision: 0) unless donated_item.value.blank? %>
              </td>

             <td class="px-4 py-4 align-top truncate">
                <span class="<%= donated_item_status_class(donated_item.status) %>">
                  <%= donated_item.status %>
                </span>
              </td>
              <td class="px-4 py-4 align-top truncate">
                <%= donated_item.expiry_date.to_formatted_s(:usa) unless donated_item.expiry_date.blank? %>
              </td>

              <td class="px-4 py-4 align-top truncate">
                <%= donated_item.club&.name ||
                      donated_item.program&.program_name %>
              </td>

              <td class="px-4 py-4 align-top truncate">
                <%= donated_item.requirements %>
              </td>

              
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <p class="px-4 py-4">
    No records to view
  </p>
<% end %>

<br>
