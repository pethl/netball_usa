<div class="flex flex-wrap items-center justify-between mb-4 gap-4">
  <!-- Tabs -->
  <ul class="flex border-b flex-shrink-0">
    <li class="mr-1">
      <%= link_to "All Items", donated_items_path,
            class: "border-blue-200 inline-block py-2 px-4 text-gray-700 border-b-2 border-transparent hover:border-gray-300 #{'border-b-blue-900 font-semibold' if params[:status].blank?}" %>
    </li>

    <% @statuses.each do |status| %>
      <li class="mr-1">
        <%= link_to status,
              donated_items_path(status: status),
              class: "inline-block py-2 px-4 text-gray-700 border-b-2 border-transparent hover:border-gray-300 #{'border-b-blue-900 font-semibold' if params[:status] == status}" %>
      </li>
    <% end %>
  </ul>

  <!-- Search box -->
  <div class="flex items-center gap-2 flex-1 justify-end">
    <input
      type="text"
      placeholder="🔍 Search by description, type, donor, status..."
      class="p-2 border rounded w-full max-w-md shadow-sm shadow-gray-400 focus:outline-none focus:ring-1 focus:ring-blue-900"
      data-controller="search"
      data-search-url-value="<%= request.path %>"
      data-search-delay-value="300"
      data-search-target="input"
      data-action="input->search#search"
      autocomplete="off"
      value="<%= params[:query].presence || params[:search] %>" />

    <%= link_to "Clear",
        request.path,
        class: "text-sm text-blue-900 underline hover:font-semibold whitespace-nowrap" %>
  </div>
</div>