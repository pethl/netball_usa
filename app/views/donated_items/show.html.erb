<% content_for(:page_title, "#{@donated_item.item_type.presence || 'Donated Item'} - #{number_to_currency(@donated_item.value, precision: 0)}") %>

<div class="mt-2 mx-auto w-full max-w-5xl">
  <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">

    <div class="text-left">
      <%= render @donated_item %>
    </div>

    <br>

    <div class="mt-2 mb-8 ml-2">
      <%= link_to "Edit this Donated Item", edit_donated_item_path(@donated_item), class: link_class %> <br>
      <%= link_to "<< Back to Donated Items", donated_items_path, class: link_class %>
    <br>
    <% if is_admin? %>
  <div class="mt-4 ml-2 inline-block border border-red-400 rounded px-3 py-2 bg-red-50">
        <span class="text-xs font-semibold uppercase text-red-700">
          Admin Only
        </span>

        <div class="mt-1">
          <%= button_to "Delete this record",
                @donated_item,
                method: :delete,
                data: { turbo_confirm: "Are you sure you want to delete this donated item?" },
                class: "text-sm text-red-600 hover:text-red-800" %>
        </div>
      </div>
    <% end %>
    <br>
    <% if @donated_item.status == "Available" %>
      <div class="mt-3">
        <%= link_to "Request This Item",
              new_donated_item_request_path(donated_item_id: @donated_item.id),
              class: form_button_class %>
      </div>
    <% end %>
    </div>

  </div>
</div>
