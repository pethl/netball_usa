<div id="<%= dom_id donated_item %>">

  <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">


    <% if donated_item.club.present? || donated_item.program.present? %>
      <div class="mb-6 rounded-lg border border-green-300 bg-green-50 px-4 py-3 text-center">
        <div class="text-xs font-semibold uppercase tracking-wide text-green-700">
          Approved For
        </div>

        <div class="mt-1 text-lg font-semibold text-green-900">
          <%=
            [
              donated_item.club&.name,
              donated_item.program&.program_name
            ].compact.join(" • ")
          %>
        </div>
      </div>
    <% end %>




    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">

  <div class="mb-2 md:col-span-2 sm:mt-4 md:mt-0">
    <p class="<%= label_class %>">Item Description</p>
   <div class="mt-1 px-3 py-2 border rounded bg-gray-50 text-sm whitespace-pre-wrap break-words"><%= donated_item.description.presence || "-" %>
   </div>
  </div>

  <div class="mb-2">
    <p class="<%= label_class %>">Item Type</p>
    <div class="mt-1 p-2 border rounded bg-gray-50">
      <%= donated_item.item_type.presence || "-" %>
    </div>
  </div>

 <div class="mb-2">
  <p class="<%= label_class %>">Status</p>
  <div class="mt-1 p-2 border rounded bg-gray-50">
    <span class="<%= donated_item_status_class(donated_item.status) %>">
      <%= donated_item.status.presence || "-" %>
    </span>
  </div>
</div>

  <div class="mb-2">
    <p class="<%= label_class %>">Value $</p>
    <div class="mt-1 p-2 border rounded bg-gray-50 text-right">
      <%= donated_item.value.present? ? number_to_currency(donated_item.value, precision: 0) : "-" %>
    </div>
  </div>

  <div class="mb-2">
    <p class="<%= label_class %>">Expiry Date</p>
    <div class="mt-1 p-2 border rounded bg-gray-50">
      <%= donated_item.expiry_date.present? ? donated_item.expiry_date.to_formatted_s(:usa) : "-" %>
    </div>
  </div>

  <div class="mb-2 md:col-span-2">
    <p class="<%= label_class %>">Donor Name</p>
    <div class="mt-1 p-2 border rounded bg-gray-50">
      <%= donated_item.donor_name.presence || "-" %>
    </div>
  </div>

  

  <div class="mb-2 md:col-span-2">
    <p class="<%= label_class %>">Any Other Requirement</p>
    <div class="mt-1 px-3 py-2 border rounded bg-gray-50 text-sm whitespace-pre-wrap break-words"><%= donated_item.requirements.presence || "-" %></div>
  </div>

  <% if is_admin? %>
    <div class="mb-2 md:col-span-2">
      <p class="<%= label_class %>">Internal Notes</p>
      <div class="mt-1 px-3 py-2 border rounded bg-gray-50 text-sm whitespace-pre-wrap break-words"><%= donated_item.internal_notes.presence || "-" %></div>
    </div>
  <% end %>

    </div>
  </div>

</div>