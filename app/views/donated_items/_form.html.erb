<%= form_with(model: donated_item) do |form| %>

  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

    <div class="mb-2 md:col-span-2 sm:mt-4 md:mt-0">
      <%= form.label :description, "Item Description*", class: label_class %>
      <div class="mt-1">
        <% error_id = donated_item.errors[:description].any? ? "#{donated_item.model_name.singular}_description_error" : nil %>
        <%= form.text_area :description,
            class: error_class(donated_item, :description, base: form_input_class),
            size: "20x5",
            aria: { invalid: donated_item.errors[:description].any?, describedby: error_id } %>
      </div>
      <%= field_error_for(donated_item, :description, id: error_id) %>
    </div>

    <div class="mb-2">
      <%= form.label :item_type, "Item Type*", class: label_class %>
      <div class="mt-1">
        <% error_id = donated_item.errors[:item_type].any? ? "#{donated_item.model_name.singular}_item_type_error" : nil %>
        <%= form.select :item_type,
            options_for_select(donated_items_type, selected: donated_item.item_type),
            { prompt: true },
            class: error_class(donated_item, :item_type, base: form_input_class),
            aria: { invalid: donated_item.errors[:item_type].any?, describedby: error_id } %>
      </div>
      <%= field_error_for(donated_item, :item_type, id: error_id) %>
    </div>

    <div class="mb-2">
      <%= form.label :status, "Status*", class: label_class %>
      <div class="mt-1">
        <% error_id = donated_item.errors[:status].any? ? "#{donated_item.model_name.singular}_status_error" : nil %>
        <%= form.select :status,
            options_for_select(donated_items_status, selected: donated_item.status.presence || "Available"),
            { prompt: true },
            class: error_class(donated_item, :status, base: form_input_class),
            aria: { invalid: donated_item.errors[:status].any?, describedby: error_id } %>
      </div>
      <%= field_error_for(donated_item, :status, id: error_id) %>
    </div>

    <div class="mb-2">
      <%= form.label :value, "Value $", class: label_class %>
      <div class="mt-1 ">
        <% error_id = donated_item.errors[:value].any? ? "#{donated_item.model_name.singular}_value_error" : nil %>
       <%= form.number_field :value,
            class: "#{error_class(donated_item, :value, base: form_input_class)} text-right",
            min: 0,
            step: 1,
            aria: { invalid: donated_item.errors[:value].any?, describedby: error_id } %>
      </div>
      <%= field_error_for(donated_item, :value, id: error_id) %>
    </div>

    <div class="mb-2">
      <%= form.label :expiry_date, "Expiry Date (if applicable)", class: label_class %>
      <div class="mt-1">
        <%= form.date_field :expiry_date, class: form_input_class %>
      </div>
    </div>

    <div class="mb-2 md:col-span-2">
      <%= form.label :donor_name, "Donor Name", class: label_class %>
      <div class="mt-1">
        <%= form.text_field :donor_name, class: form_input_class %>
      </div>
    </div>

    <div class="mb-2 md:col-span-2">
      <%= form.label :requirements, "Any Other Requirement", class: label_class %>
      <div class="mt-1">
        <%= form.text_area :requirements, class: form_input_class, size: "20x5" %>
      </div>
    </div>

    <div class="mb-2 md:col-span-2">
      <%= form.label :internal_notes, "Internal Notes", class: label_class %>
      <div class="mt-1">
        <%= form.text_area :internal_notes, class: form_input_class, size: "20x5" %>
      </div>
    </div>

    <div class="justify-start ">
      <%= form.submit "Save Record", class: form_button_class %>
    </div>

  </div>

<% end %>