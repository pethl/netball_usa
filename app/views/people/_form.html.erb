<!-- Main Container -->
<div class="container m-4 mr-4 w-fit">

    <%= form_with(model: person, local: true) do |form| %>
    <%= form_errors_for(person) %>

    <div class="flex flex-col gap-6">
        <%= render "personal_details_fields",
            form: form,
            person: person %>

        <% if person.role == "University Squad" ||
            person.university_athlete_profile.present? %>

                <%= form.fields_for :university_athlete_profile do |profile_form| %>
                <%= render "university_athlete_profile_fields",
                form: profile_form %>
                <% end %>

        <% end %>

        <%= render "umpire_scorer_fields",
            form: form,
            person: person %>

        <%= render "frequent_flyer_fields",
            form: form,
            person: person %>

        <%= render "event_uniform_fields",
            form: form,
            person: person %>

        <% if is_admin? %>
        <%= render "trainer_ambassador_fields",
              form: form,
              person: person %>
        <% end %>

        <%= render "document_fields",
            form: form,
            person: person %>

        <% if is_admin? %>
        <%= render "admin_notes_fields",
              form: form,
              person: person %>
        <% end %>

        <% if current_user&.role != "na_people" %>
        <%= render "event_assignment_fields",
              form: form,
              person: person %>
        <% end %>
    </div>

    <div class="mt-6 pb-4 text-right">
        <%= form.submit "Save Record",
            class: large_form_button_class %>
    </div>
    <% end %>

</div>