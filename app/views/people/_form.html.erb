<!-- Main Container -->
<div class="container m-4 mr-4 w-fit">


    <!-- Form Start -->
    <%= form_with(model: person, local: true) do |form| %>
    <!-- Error Display -->
    <%= form_errors_for(person) %>

    <%= render "personal_details_fields",
      form: form,
      person: person %>

    <br>

    <%= render "umpire_scorer_fields",
      form: form,
      person: person %>

    <br>

    <%= render "frequent_flyer_fields",
      form: form,
      person: person %>

    <br>

    <%= render "event_uniform_fields",
      form: form,
      person: person %>

    <br>


    <!-- Trainers/Ambassadors Section -->
    <% if is_admin? %>
    <%= render "trainer_ambassador_fields",
      form: form,
      person: person %>
    <% end %>

    <br>

    <%= render "document_fields",
      form: form,
      person: person %>

    <br>

    <% if is_admin? %>
    <%= render "admin_notes_fields",
        form: form,
        person: person %>
    <% end %>

    <br>

    <% if current_user&.role != "na_people" %>
    <%= render "event_assignment_fields",
        form: form,
        person: person %>
    <% end %>

    <div class="text-right">
        <%= form.submit "Save Record", class: form_button_class %>
    </div>
    <% end %>
</div>