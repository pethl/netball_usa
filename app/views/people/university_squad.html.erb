<% content_for(:page_title, "USA University Squad") %>

<%
  view_mode =
    if %w[full future].include?(params[:view])
      params[:view]
    else
      "summary"
    end

  active_filters = request.query_parameters.slice(
    "country",
    "state",
    "city",
    "college",
    "query"
  )

  tab_base_class =
"border-b-2 px-1 py-2 text-sm font-medium transition-colors duration-200"

  active_tab_class =
    "#{tab_base_class} border-blue-900 text-blue-900"

  inactive_tab_class =
    "#{tab_base_class} border-transparent text-gray-500 hover:border-blue-300 hover:text-blue-800"
%>

<!-- Actions and Filters -->
<div class="my-2 flex flex-wrap items-start justify-between gap-4">
  <div>
    <%= link_to "Add New Squad Member",
          new_person_path(role: "University Squad"),
          class: form_button_class %>
  </div>

  <div class="min-w-0">
    <%= render "university_squad_filters",
          view_mode: view_mode %>
  </div>
</div>

<%= render "university_squad_nav",
      active_view: view_mode,
      active_filters: active_filters %>

<!-- Results -->
<% if @people.any? %>
  <% if view_mode == "summary" %>
    <%= render "university_squad_summary",
          people: @people %>
  <% else %>
    <%= render "university_squad_full",
          people: @people %>
  <% end %>
<% else %>
  <p class="px-4 py-4 text-gray-500">
    No USA University squad members match these filters.
  </p>
<% end %>