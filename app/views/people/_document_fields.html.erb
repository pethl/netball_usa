<section class="rounded-lg border border-gray-200 border-t-4 border-t-blue-900 bg-white p-6 shadow-sm md:col-span-3">
    <div class="mb-5 flex flex-col gap-1 border-b border-gray-200 pb-3 sm:flex-row sm:items-baseline sm:justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-blue-900">
            Documents
        </h2>

        <p class="text-xs text-gray-500">
            Headshot and resume files
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">

        <!-- Headshot -->
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-6 transition-colors duration-200 hover:bg-blue-50">
            <h3 class="text-sm font-semibold text-blue-900">
                Headshot
            </h3>

            <div class="mt-4 flex items-center">
                <%= form.check_box :headshot_present,
              class: "h-4 w-4 rounded border-gray-300 text-blue-900 focus:ring-blue-800" %>

                <%= form.label :headshot_present,
              "Have Headshot?",
              class: "ml-2 text-sm font-medium text-gray-700" %>
            </div>

            <div class="mt-5">
                <%= form.label :headshot,
              "Headshot File",
              class: label_class %>

                <div class="mt-1">
                    <%= form.hidden_field :headshot,
                value: form.object.cached_headshot_data,
                id: nil %>

                    <%= form.file_field :headshot,
                class: "block w-full text-xs text-gray-700 border border-gray-300 rounded-lg cursor-pointer bg-white focus:outline-none" %>
                </div>
            </div>

            <% if person.headshot_url.present? %>
            <div class="mt-5 border-t border-gray-200 pt-4">
                <p class="mb-2 text-xs font-medium text-gray-500">
                    Current Headshot
                </p>

                <%= image_tag person.headshot_url,
                class: "h-24 w-auto rounded-md border border-gray-200 bg-white" %>

                <p class="mt-2 text-xs italic text-gray-500">
                    Upload a new file above to replace it.
                </p>
            </div>
            <% end %>
        </div>

        <!-- Résumé -->
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-6 transition-colors duration-200 hover:bg-blue-50">
            <h3 class="text-sm font-semibold text-blue-900">
                Resume
            </h3>

            <div class="mt-4 flex items-center">
                <p class="text-sm text-gray-600">
                    Upload the latest resume or CV.
                </p>
            </div>

            <div class="mt-5">
                <%= form.label :resume,
              "Resume File",
              class: label_class %>

                <div class="mt-1">
                    <%= form.hidden_field :resume,
                value: form.object.cached_resume_data,
                id: nil %>

                    <%= form.file_field :resume,
                class: "block w-full text-xs text-gray-700 border border-gray-300 rounded-lg cursor-pointer bg-white focus:outline-none" %>
                </div>
            </div>

            <% if person.resume_url.present? %>
            <div class="mt-5 border-t border-gray-200 pt-4">
                <p class="mb-2 text-xs font-medium text-gray-500">
                    Current Resume
                </p>

                <%= image_tag person.resume_url,
                class: "h-24 w-auto rounded-md border border-gray-200 bg-white" %>

                <p class="mt-2 text-xs italic text-gray-500">
                    Upload a new file above to replace it.
                </p>
            </div>
            <% end %>
        </div>

    </div>
</section>