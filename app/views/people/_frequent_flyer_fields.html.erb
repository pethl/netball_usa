<section data-controller="accordion" class="rounded-lg border border-gray-200 border-t-4 border-t-blue-900 bg-white shadow-sm md:col-span-3">
  <button type="button" data-action="click->accordion#toggle" class="flex w-full items-center justify-between p-6 text-left transition-colors duration-200 hover:bg-blue-50">
    <span class="text-sm font-semibold uppercase tracking-wide text-blue-900">
      Frequent Flyer Details - [NA Operations Personnel Only]
    </span>

    <span class="text-xs font-medium text-blue-800">
      Show / hide
    </span>
  </button>

  <div data-accordion-target="body" class="hidden border-t border-gray-200 p-6">
    <p class="mb-5 text-xs text-gray-500">
      Add airline membership details when relevant.
    </p>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      <%= form.fields_for :frequent_flyer_numbers do |ffn_form| %>
        <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
          <div>
            <%= ffn_form.label :airline, class: label_class %>

            <div class="mt-1">
              <%= ffn_form.text_field :airline,
                    class: input_class %>
            </div>
          </div>

          <div class="mt-4">
            <%= ffn_form.label :number, class: label_class %>

            <div class="mt-1">
              <%= ffn_form.text_field :number,
                    class: input_class %>
            </div>
          </div>

          <div class="mt-4 flex items-center">
            <%= ffn_form.check_box :_destroy,
                  class: "h-4 w-4 rounded border-gray-300 text-blue-900 focus:ring-blue-800" %>

            <%= ffn_form.label :_destroy,
                  "Remove this frequent flyer number",
                  class: "ml-2 text-sm italic text-blue-900" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>