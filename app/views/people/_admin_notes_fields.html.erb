<section data-controller="accordion" class="rounded-lg border border-gray-200 border-t-4 border-t-blue-900 bg-white shadow-sm">
    <button type="button" data-action="click->accordion#toggle" class="flex w-full items-center justify-between p-6 text-left transition-colors duration-200 hover:bg-blue-50">
        <span class="text-sm font-semibold uppercase tracking-wide text-blue-900">
            Admin Notes
        </span>

        <span class="text-xs font-medium text-blue-800">
            Show / hide
        </span>
    </button>

    <div data-accordion-target="body" class="<%= "hidden" unless person.notes.present? %> border-t border-gray-200 p-6">
        <p class="mb-4 text-xs text-gray-500">
            Internal notes visible to administrators.
        </p>

        <%= form.text_area :notes,
          rows: 5,
          class: input_class,
          placeholder: "Add internal notes..." %>
    </div>
</section>