<section class="rounded-lg border border-gray-200 border-t-4 border-t-blue-900 bg-white p-6 shadow-sm transition-colors duration-200 hover:bg-blue-50 md:col-span-3">
    <div class="mb-5 flex flex-col gap-1 border-b border-gray-200 pb-3 sm:flex-row sm:items-baseline sm:justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-blue-900">
            Umpire and Scorer Details
        </h2>

        <p class="text-xs text-gray-500">
            Certification and badge information
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">

        <!-- NA Umpire Level -->
        <div>
            <%= form.label :level,
            "NA Umpire Level (Admin Only)",
            class: label_class %>

            <div class="mt-1">
                <%= form.select :level,
              options_for_select(
                people_level,
                selected: person.level
              ),
              { prompt: true },
              class: input_class %>
            </div>
        </div>

        <!-- Umpire Badge Level -->
        <div>
            <%= form.label :level_submitted,
            "Umpire Badge Level",
            class: label_class %>

            <div class="mt-1">
                <%= form.text_field :level_submitted,
              placeholder: "Country and level of award",
              class: input_class %>
            </div>
        </div>

        <!-- Level Notes -->
        <div>
            <%= form.label :level_note,
            "Level Notes",
            class: label_class %>

            <div class="mt-1">
                <%= form.text_area :level_note,
              rows: 1,
              class: input_class %>
            </div>
        </div>

        <!-- Certification Date -->
        <div>
            <%= form.label :certification_date,
            "Certification Date",
            class: label_class %>

            <div class="mt-1">
                <%= form.date_field :certification_date,
              class: input_class %>
            </div>
        </div>

        <!-- Certification Upload -->
        <div>
            <%= form.label :certification,
            "Certification File",
            class: label_class %>

            <div class="mt-1">
                <%= form.hidden_field :certification,
              value: form.object.cached_certification_data,
              id: nil %>

                <%= form.file_field :certification,
              class: "block w-full text-xs text-gray-700 border border-gray-300 rounded-lg cursor-pointer bg-white focus:outline-none" %>
            </div>
        </div>

        <!-- Existing Certification -->
        <% if person.certification_url.present? %>
        <div>
            <p class="<%= label_class %>">
                Current Certification
            </p>

            <div class="mt-1 rounded-md border border-gray-200 bg-gray-50 p-3">
                <%= image_tag person.certification_url,
                class: "h-20 w-auto rounded" %>

                <p class="mt-2 text-xs italic text-gray-500">
                    Upload a new file above to replace it.
                </p>
            </div>
        </div>
        <% end %>

    </div>
</section>