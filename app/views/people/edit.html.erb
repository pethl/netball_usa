<% content_for(:page_title, "Edit: #{@person.full_name}") %>

<% inactive = @person.status.to_s.casecmp?("Inactive") %>

<div class="<%= "rounded-lg bg-gray-200 p-4" if inactive %>">
    <% if inactive %>
    <div class="mb-4 text-sm font-semibold uppercase tracking-wide text-gray-600">
        Inactive Record
    </div>
    <% end %>

    <%= render "form", person: @person %>
</div>

<!-- Page Actions -->
<div class="m-4 px-6">
    <div class="border-t border-gray-200 pt-6">

        <!-- Navigation -->
        <div class="flex flex-wrap items-center gap-6 text-sm">
            <%= link_to "View Person",
            @person,
            class: "font-medium text-blue-900 hover:text-blue-700 hover:underline" %>

            <% if can?(:manage, Person) %>
            <%= link_to "← Back to People",
              people_path,
              class: "font-medium text-blue-900 hover:text-blue-700 hover:underline" %>
            <% end %>
        </div>


        <!-- Destructive Action -->
        <% if current_user&.id.in?([9, 10]) %>
        <div class="mt-6 border-t border-gray-200 pt-6">
            <%= button_to "Delete this Person",
          person_path(@person),
          method: :delete,
          data: {
            turbo_confirm: "Are you sure you want to delete this person?"
          },
          class: "inline-flex items-center justify-center rounded-md border border-red-500 bg-white px-4 py-2 text-sm font-medium text-red-600 transition-colors duration-200 hover:bg-red-50 hover:text-red-800" %>
        </div>
        <% end %>
    </div>