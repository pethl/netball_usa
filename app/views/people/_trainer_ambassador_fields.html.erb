<section class="rounded-lg border border-gray-200 border-t-4 border-t-blue-900 bg-white p-6 shadow-sm transition-colors duration-200 hover:bg-blue-50 md:col-span-3">
    <div class="mb-5 flex flex-col gap-1 border-b border-gray-200 pb-3 sm:flex-row sm:items-baseline sm:justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-blue-900">
            Trainer and Ambassador Details
        </h2>

        <p class="text-xs text-gray-500">
            Training completed with Netball America
        </p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">

        <!-- In-Person Training -->
        <label class="flex cursor-pointer items-center gap-4 rounded-lg border border-gray-200 bg-gray-50 p-4">
            <%= form.check_box :in_person_trained,
            class: "h-6 w-6 flex-none rounded border-gray-300 text-blue-900 focus:ring-blue-800" %>

            <span class="ml-3 text-sm font-medium text-gray-700">
                In-Person Trained
            </span>
        </label>

        <!-- Virtual Training -->
        <label class="flex cursor-pointer items-center gap-4 rounded-lg border border-gray-200 bg-gray-50 p-4">
            <%= form.check_box :virtually_trained,
            class: "h-6 w-6 flex-none rounded border-gray-300 text-blue-900 focus:ring-blue-800" %>

            <span class="ml-3 text-sm font-medium text-gray-700">
                Virtually Trained
            </span>
        </label>

        <!-- Booth Training -->
        <label class="flex cursor-pointer items-center gap-4 rounded-lg border border-gray-200 bg-gray-50 p-4">
            <%= form.check_box :booth_trained,
            class: "h-6 w-6 flex-none rounded border-gray-300 text-blue-900 focus:ring-blue-800" %>

            <span class="ml-3 text-sm font-medium text-gray-700">
                Booth Trained
            </span>
        </label>

    </div>
</section>