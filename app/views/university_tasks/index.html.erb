<% content_for(:page_title, "USA University Tasks") %>
<div class="mt-4">
<%= link_to "Add Task",
  new_university_task_path,
  class: form_button_class %>
</div>

<% if @university_tasks.any? %>
<div class="relative mt-4 overflow-x-auto ml-2">
    <table class="w-full text-left rtl:text-right">
        <thead class="bg-gray-200 border-b text-gray-500 font-light text-xs">
            <tr>
                <th scope="col" class="px-6 py-3">
                    Objective
                </th>

                <th scope="col" class="px-6 py-3">
                    Task
                </th>

                <th scope="col" class="px-6 py-3">
                    Status
                </th>

                <th scope="col" class="px-6 py-3">
                    Assigned
                </th>

                <th scope="col" class="px-6 py-3">
                    Due Date
                </th>
            </tr>
        </thead>

        <tbody>
            <% @university_tasks.each do |task| %>
            <tr class="bg-white border-b hover:bg-gray-100">
                <td class="align-top px-6 py-4 font-medium text-gray-800">
                    <%= link_to task.university_objective.title,
                university_objective_path(task.university_objective),
                class: link_class %>
                </td>

                <td class="align-top px-6 py-4">
                    <%= link_to task.action, university_task_path(task), class: link_class %>
                </td>

                <td class="align-top px-6 py-4 whitespace-nowrap">
                    <%= task.status %>
                </td>

                <td class="align-top px-6 py-4 whitespace-nowrap">
                    Not assigned
                </td>

                <td class="align-top px-6 py-4 whitespace-nowrap">
                    <% if task.due_date.present? %>
                    <%= task.due_date.to_formatted_s(:usa) %>
                    <% else %>
                    —
                    <% end %>
                </td>
            </tr>
            <% end %>
        </tbody>
    </table>
</div>
<% else %>
<p class="px-6 py-4">
    No university tasks to view
</p>
<% end %>