<%
  if university_task.persisted?
    form_url = university_task_path(university_task)
  elsif university_objective.present?
    form_url =
      university_objective_university_tasks_path(
        university_objective
      )
  else
    form_url = university_tasks_path
  end

  if university_objective.present?
    cancel_path =
      university_objective_path(university_objective)
  else
    cancel_path = university_tasks_path
  end
%>

<%= form_with model: university_task, url: form_url do |form| %>
<% if university_task.errors.any? %>
<div class="mb-6 rounded-md bg-red-50 p-4 text-red-700">
    <h2 class="font-semibold">
        Please correct the following:
    </h2>

    <ul class="mt-2 list-disc pl-5">
        <% university_task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
        <% end %>
    </ul>
</div>
<% end %>

<% if university_objective.blank? %>
<div class="my-4">
    <%= form.label :university_objective_id,
        "Objective",
        class: "block mb-2 font-medium text-gray-700" %>

    <%= form.collection_select :university_objective_id,
        UniversityObjective.active.ordered,
        :id,
        :title,
        { prompt: "Select objective" },
        class: form_input_class,
        required: true %>
</div>
<% end %>

<div class="my-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div>
        <%= form.label :category,
        class: "block mb-2 font-medium text-gray-700" %>

        <%= form.select :category,
        options_for_select(
          university_task_categories,
          university_task.category
        ),
        { prompt: "Select category" },
        class: form_input_class %>
    </div>

    <div>
        <%= form.label :status,
        class: "block mb-2 font-medium text-gray-700" %>

        <%= form.select :status,
        options_for_select(
          university_task_statuses,
          university_task.status
        ),
        { prompt: "Select status" },
        class: form_input_class %>
    </div>

    <div>
        <%= form.label :due_date,
        "Due Date",
        class: "block mb-2 font-medium text-gray-700" %>

        <%= form.date_field :due_date,
        class: form_input_class %>
    </div>

    <div>
        <%= form.label :position,
        "Position",
        class: "block mb-2 font-medium text-gray-700" %>

        <%= form.number_field :position,
        min: 0,
        class: form_input_class %>
    </div>
</div>

<div class="my-4">
    <%= form.label :action,
      "Task",
      class: "block mb-2 font-medium text-gray-700" %>

    <%= form.text_area :action,
      rows: 4,
      class: form_input_class,
      required: true %>
</div>

<div class="my-4">
    <%= form.label :notes,
      class: "block mb-2 font-medium text-gray-700" %>

    <%= form.text_area :notes,
      rows: 6,
      class: form_input_class %>
</div>

<div class="my-6 flex items-center gap-4">
    <%= form.submit "Save Task",
      class: form_button_class %>

    <%= link_to "Cancel",
      cancel_path,
      class: link_class %>
</div>
<% end %>