<% content_for(:page_title, "USA University Task") %>

<div class="mt-2 w-full">
    <div class="bg-white px-4 py-8 shadow sm:rounded-lg sm:px-8">
        <div class="text-left">
            <%= render @university_task %>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-4">
            <%= link_to "Edit Task",
    edit_university_task_path(@university_task),
    class: form_button_class %>

            <%= link_to "<< Back to Objective",
    university_objective_path(
      @university_task.university_objective
    ),
    class: link_class %>

            <%= link_to "<< All Tasks",
    university_tasks_path,
    class: link_class %>
        </div>

        <% if is_admin? %>
        <div class="mt-8 inline-flex items-center gap-3 rounded-md border border-red-400 bg-white px-3 py-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-red-600">
                Admin Only
            </span>

            <%= button_to "Delete Task",
      university_task_path(@university_task),
      method: :delete,
      data: {
        turbo_confirm: "Are you sure you want to delete this task?"
      },
      class: "rounded border border-red-600 bg-white px-3 py-1 text-sm font-medium text-red-600 hover:bg-red-600 hover:text-white" %>
        </div>
        <% end %>
        </div>
    </div>