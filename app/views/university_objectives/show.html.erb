<% content_for(:page_title, "USA University Objective") %>

<div class="w-full">


    <div class="relative mt-6 flex min-h-32 w-full items-center justify-center overflow-hidden rounded-lg border-l-8 border-blue-900 bg-blue-100 px-16 py-6 shadow-sm">
        <span class="absolute left-5 top-1 text-7xl font-serif leading-none text-blue-300">
            &ldquo;
        </span>

        <p class="m-0 w-full text-center text-2xl font-medium italic leading-relaxed text-gray-800"><%= @university_objective.description.presence || "No description has been added." %></p>
    </div>

    <br>


    <div class="mt-10">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
            <h2 class="text-xl font-semibold text-gray-800">
                Tasks
            </h2>

            <%= link_to "Add Task",
      new_university_objective_university_task_path(
        @university_objective
      ),
      class: form_button_class %>
        </div>

        <% if @university_tasks.any? %>
        <div class="relative overflow-x-auto">
            <table class="w-full text-left rtl:text-right">
                <thead class="bg-gray-200 border-b text-gray-500 font-light text-xs">
                    <tr>
                        <th scope="col" class="px-6 py-3">
                            Task
                        </th>

                        <th scope="col" class="px-6 py-3">
                            Category
                        </th>

                        <th scope="col" class="px-6 py-3">
                            Status
                        </th>

                        <th scope="col" class="px-6 py-3">
                            Assigned
                        </th>

                        <th scope="col" class="px-6 py-3">
                            Due Date
                        </th>
                    </tr>
                </thead>

                <tbody>
                    <% @university_tasks.each do |task| %>
                    <tr class="bg-white border-b hover:bg-gray-100">
                        <td class="align-top px-6 py-4">
                            <%= link_to task.action,
                  university_task_path(task),
                  class: link_class %>
                        </td>

                        <td class="align-top px-6 py-4 whitespace-nowrap">
                            <%= task.category %>
                        </td>

                        <td class="align-top px-6 py-4 whitespace-nowrap">
                            <%= task.status %>
                        </td>

                        <td class="align-top px-6 py-4 whitespace-nowrap">
                            <% if task.assigned_user.present? %>
                            <%= task.assigned_user.full_name.presence || task.assigned_user.email %>
                            <% else %>
                            <span class="font-semibold text-blue-800">
                                Not assigned
                            </span>
                            <% end %>
                        </td>

                        <td class="align-top px-6 py-4 whitespace-nowrap">
                            <% if task.due_date.present? %>
                            <%= task.due_date.to_formatted_s(:usa) %>
                            <% else %>
                            —
                            <% end %>
                        </td>
                    </tr>
                    <% end %>
                </tbody>
            </table>
        </div>
        <% else %>
        <p class="rounded-md bg-gray-50 px-6 py-4 text-gray-500">
            No tasks have been added to this objective.
        </p>
        <% end %>
    </div>


    <div class="mt-8">
        <div class="my-4 flex items-center space-x-4">
            <%= link_to "Edit Objective",
      edit_university_objective_path(@university_objective),
      class: form_button_class %>

            <%= link_to "<< Back to Strategy",
      university_objectives_path,
      class: link_class %>
        </div>
    </div>
</div>