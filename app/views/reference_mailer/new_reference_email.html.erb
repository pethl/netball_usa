<div style="margin:0 auto;max-width:560px;font-family:Arial,sans-serif;color:#1f2937;line-height:1.6;">
  <div style="padding:20px;text-align:center;border-bottom:4px solid #173b73;">
    <%= image_tag asset_url("Netball_America_Logo.png"), alt: "Netball America", style: "max-width:180px;height:auto;" %>
  </div>

  <div style="padding:28px 24px;">
    <h1 style="margin:0 0 16px;color:#173b73;font-size:22px;">New reference data created</h1>
    <p>A new reference record has been created in the Netball America database.</p>

    <div style="margin:20px 0;padding:16px;border-left:4px solid #173b73;background:#f3f6fa;">
      <p style="margin:0 0 8px;"><strong>Group:</strong> <%= @reference.group %></p>
      <p style="margin:0 0 8px;"><strong>Value:</strong> <%= @reference.value %></p>
      <p style="margin:0 0 8px;"><strong>Key:</strong> <%= @reference.key.presence || "—" %></p>
      <p style="margin:0 0 8px;"><strong>Description:</strong> <%= @reference.desc.presence || "—" %></p>
      <p style="margin:0 0 8px;"><strong>Active:</strong> <%= @reference.active? ? "Yes" : "No" %></p>
      <p style="margin:0 0 8px;"><strong>Created:</strong> <%= @reference.created_at.to_fs(:long) %></p>
      <p style="margin:0;"><strong>Record ID:</strong> <%= @reference.id %></p>
    </div>

    <p style="margin-top:24px;font-size:13px;color:#6b7280;">This is an automated notification from the Netball America system.</p>
  </div>
</div>
