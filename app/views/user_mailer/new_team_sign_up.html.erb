<div style="margin:0 auto;max-width:560px;font-family:Arial,sans-serif;color:#1f2937;line-height:1.6;">
  <div style="padding:20px;text-align:center;border-bottom:4px solid #173b73;">
    <%= image_tag asset_url("Netball_America_Logo.png"), alt: "Netball America", style: "max-width:180px;height:auto;" %>
  </div>

  <div style="padding:28px 24px;">
    <h1 style="margin:0 0 16px;color:#173b73;font-size:22px;">New user registration</h1>
    <p>Hi Sonya,</p>
    <p>A new user has been registered on the Netball America database:</p>
    <div style="margin:20px 0;padding:12px 16px;border-left:4px solid #173b73;background:#f3f6fa;">
      <p style="margin:0 0 4px;font-weight:bold;"><%= @user.first_name %> <%= @user.last_name %></p>
      <p style="margin:0;"><%= mail_to @user.email %></p>
    </div>
    <p style="margin-top:24px;font-size:13px;color:#6b7280;">This is an automated notification from the Netball America system.</p>
  </div>
</div>
