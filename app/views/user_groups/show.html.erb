<% content_for(:page_title, @user_group.name) %>

<div class="w-full">
    <div class="mb-8 rounded-lg border-l-4 border-blue-900 bg-blue-100 px-6 py-4">
        <p class="text-sm text-gray-700">
            <%= @user_group.description %>
        </p>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <div>
            <h2 class="mb-4 text-lg font-semibold text-gray-800">
                Current Members
            </h2>

            <% if @memberships.any? %>
            <div class="overflow-hidden rounded-lg border border-gray-200">
                <% @memberships.each do |membership| %>
                <div class="flex items-center justify-between border-b border-gray-200 bg-white px-4 py-3 last:border-b-0">
                    <div>
                        <p class="font-medium text-gray-900">
                            <%= membership.user.full_name %>
                        </p>

                        <p class="text-sm text-gray-500">
                            <%= membership.user.email %>
                        </p>
                    </div>

                    <%= button_to "Remove",
                user_group_membership_path(membership),
                method: :delete,
                data: {
                  turbo_confirm: "Remove this user from #{@user_group.name}?"
                },
                class: "rounded border border-red-500 bg-white px-3 py-1 text-sm text-red-600 hover:bg-red-600 hover:text-white" %>
                </div>
                <% end %>
            </div>
            <% else %>
            <p class="text-gray-500">
                No users have been added to this group.
            </p>
            <% end %>
        </div>

        <div>
            <h2 class="mb-4 text-lg font-semibold text-gray-800">
                Add Member
            </h2>

            <% if @available_users.any? %>
            <%= form_with model: UserGroupMembership.new,
  url: user_group_user_group_memberships_path(
    @user_group.key
  ) do |form| %>
            <div>
                <%= form.label :user_id,
              "User",
              class: "block mb-2 font-medium text-gray-700" %>

                <%= form.collection_select :user_id,
              @available_users,
              :id,
              :full_name,
              { prompt: "Select user" },
              class: form_input_class,
              required: true %>
            </div>

            <div class="mt-4">
                <%= form.submit "Add to Team",
              class: form_button_class %>
            </div>
            <% end %>
            <% else %>
            <p class="text-gray-500">
                All active users are already members.
            </p>
            <% end %>
        </div>
    </div>
</div>