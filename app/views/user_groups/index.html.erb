<% content_for(:page_title, "User Groups") %>

<div class="w-full px-2">
  <div class="mb-8">

    <p class="mt-1 text-sm text-gray-600">
      Review group membership and add or remove users from groups.
    </p>
  </div>

  <% if @user_groups.any? %>
    <div class="space-y-3">
      <% @user_groups.each do |user_group| %>
        <%
          memberships = user_group
            .user_group_memberships
            .sort_by { |membership|
              [
                membership.user.first_name.to_s.downcase,
                membership.user.last_name.to_s.downcase
              ]
            }

          member_ids = memberships.map(&:user_id)

          available_users = @available_users.reject do |user|
            member_ids.include?(user.id)
          end
        %>

        <section data-controller="accordion"
          class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
          <div class="flex items-stretch border-b border-gray-200 bg-blue-50">
            <button type="button"
              data-action="click->accordion#toggle"
              aria-expanded="false"
              class="flex min-w-0 flex-1 items-center justify-between gap-4 px-6 py-4 text-left hover:bg-blue-100">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-3">
                  <h2 class="text-xl font-semibold text-blue-900">
                    <%= user_group.name %>
                  </h2>

                  <span class="ml-1 inline-flex min-w-20 items-center justify-center whitespace-nowrap rounded-full bg-blue-900 px-4 py-1 text-xs font-semibold text-white">
                    <%= pluralize(memberships.size, "member") %>
                  </span>
                </div>

                <p class="mt-1 font-mono text-xs text-gray-500">
                  <%= user_group.key %>
                </p>

                <% if user_group.description.present? %>
                  <p class="mt-1 text-sm text-gray-600">
                    <%= user_group.description %>
                  </p>
                <% end %>
              </div>

              <span data-accordion-target="icon"
                aria-hidden="true"
                class="shrink-0 text-xl text-blue-900 transition-transform duration-200">
                &#8964;
              </span>
            </button>

            <div class="flex shrink-0 items-center border-l border-blue-200 px-5">
              <%= link_to "Open group",
                    user_group_path(user_group.key),
                    class: link_class %>
            </div>
          </div>

          <div data-accordion-target="body"
            class="hidden grid grid-cols-1 gap-8 p-6 lg:grid-cols-2">
            <div>
              <h3 class="mb-4 text-lg font-semibold text-gray-800">
                Current members
                <span class="text-sm font-normal text-gray-500">
                  (<%= memberships.size %>)
                </span>
              </h3>

              <% if memberships.any? %>
                <div class="overflow-hidden rounded-lg border border-gray-200">
                  <% memberships.each do |membership| %>
                    <div class="flex items-center justify-between gap-4 border-b border-gray-200 px-4 py-3 last:border-b-0">
                      <div class="min-w-0">
                        <p class="truncate font-medium text-gray-900">
                          <%= membership.user.full_name %>
                        </p>

                        <p class="truncate text-sm text-gray-500">
                          <%= membership.user.email %>
                        </p>

                        <% unless membership.user.account_active? %>
                          <p class="mt-1 text-xs font-semibold text-gray-500">
                            Locked
                          </p>
                        <% end %>
                      </div>

                      <%= button_to "Remove",
                            user_group_membership_path(membership),
                            method: :delete,
                            params: { return_to: "index" },
                            data: {
                              turbo_confirm:
                                "Remove #{membership.user.full_name} from #{user_group.name}?"
                            },
                            class: "rounded border border-red-500 bg-white px-3 py-1 text-sm text-red-600 hover:bg-red-600 hover:text-white" %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="rounded-lg bg-gray-50 px-4 py-3 text-gray-500">
                  No users have been added to this group.
                </p>
              <% end %>
            </div>

            <div>
              <h3 class="mb-4 text-lg font-semibold text-gray-800">
                Assign user
              </h3>

              <% if available_users.any? %>
                <%= form_with model: UserGroupMembership.new,
                      url: user_group_user_group_memberships_path(
                        user_group.key
                      ) do |form| %>

                  <%= hidden_field_tag :return_to, "index" %>

                  <div>
                    <%= form.label :user_id,
                          "Active user",
                          class: "mb-2 block font-medium text-gray-700" %>

                    <%= form.collection_select :user_id,
                          available_users,
                          :id,
                          :full_name,
                          { prompt: "Select user" },
                          {
                            required: true,
                            class: form_input_class
                          } %>
                  </div>

                  <div class="mt-4">
                    <%= form.submit "Add to group",
                          class: form_button_class %>
                  </div>
                <% end %>
              <% else %>
                <p class="rounded-lg bg-gray-50 px-4 py-3 text-gray-500">
                  All active users are already in this group.
                </p>
              <% end %>
            </div>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <p class="rounded-lg bg-gray-50 px-4 py-3 text-gray-500">
      No active user groups are available.
    </p>
  <% end %>
</div>
