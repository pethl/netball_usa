<ul class="ml-6 text-xs xl:text-xs">
  <%
    university_group_member =
      current_user.in_group?("university_admin_team")

    us_open_group_member =
      current_user.in_group?("us_open_team")
  %>

  <% if can?(:manage, NetballEducator) && !current_user.admin? %>
    <%= render "layouts/navigation/educators_menu" %>
  <% end %>

  <% if can?(:read, UniversityObjective) && !current_user.admin? %>
    <%= render "layouts/navigation/university_menu" %>
  <% end %>

  <% if us_open_group_member && !current_user.admin? %>
    <%= render "layouts/navigation/us_open_menu" %>
  <% end %>

  <% if current_user.teamlead? %>
    <%# Team leads use their dedicated membership navigation. %>
  <% elsif current_user.admin? %>
    <%= render "layouts/navigation/admin_menu" %>
  <% else %>
    <%= render "layouts/navigation/permission_menu",
          university_group_member: university_group_member,
          us_open_group_member: us_open_group_member %>
  <% end %>
</ul>

<% 36.times do %>
  <br>
<% end %>
