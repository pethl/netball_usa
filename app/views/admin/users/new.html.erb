<% content_for(:page_title, "Create user account") %>

<div class="mx-auto max-w-3xl px-4 py-8">
  <div class="rounded-lg bg-white p-6 shadow">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Create user account</h1>
      <p class="mt-1 text-sm text-gray-600">Choose the user's current role and their initial group. Group membership is kept separately so it can drive authorization in future.</p>
    </div>

    <% if @user.errors.any? %>
      <div class="mb-6 rounded-md border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">
        <p class="font-semibold">Please correct the following:</p>
        <ul class="mt-2 list-disc pl-5">
          <% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: [:admin, @user], class: "space-y-6" do |form| %>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :first_name, required: true, autocomplete: "given-name", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :last_name, required: true, autocomplete: "family-name", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
      </div>

      <div>
        <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
        <%= form.email_field :email, required: true, autocomplete: "off", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
        <div>
          <%= form.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        </div>
      </div>

      <div>
        <%= form.label :role, class: "block text-sm font-medium text-gray-700" %>
        <%= form.select :role, @role_options, {}, required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>

      <div>
        <%= form.label :user_group_id, "User group", class: "block text-sm font-medium text-gray-700" %>
        <%= form.collection_select :user_group_id, @user_groups, :id, :name,
              { prompt: "Select a group" },
              { required: true, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" } %>
      </div>

      <div class="rounded-md bg-blue-50 p-4">
        <label class="flex items-start gap-3">
          <%= form.check_box :send_account_email, checked: true, class: "mt-1 rounded border-gray-300 text-blue-900" %>
          <span>
            <span class="block text-sm font-medium text-gray-900">Email secure account setup link</span>
            <span class="block text-sm text-gray-600">The user receives their email address and a one-time link to choose a password. Their entered password is never emailed.</span>
          </span>
        </label>
      </div>

      <div class="flex justify-end gap-3">
        <%= link_to "Cancel", users_path, class: "rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
        <%= form.submit "Create account", class: "rounded-md bg-blue-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-800" %>
      </div>
    <% end %>
  </div>
</div>
