<div style="margin:0 auto;max-width:560px;font-family:Arial,sans-serif;color:#1f2937;line-height:1.6;">
  <div style="padding:20px;text-align:center;border-bottom:4px solid #173b73;">
    <%= image_tag asset_url("Netball_America_Logo.png"), alt: "Netball America", style: "max-width:180px;height:auto;" %>
  </div>

  <div style="padding:28px 24px;">
    <h1 style="margin:0 0 16px;color:#173b73;font-size:22px;">An opportunity has been assigned to you</h1>
    <p>Hi <%= @assignee.first_name %>,</p>
    <p><%= @assigner.present? ? @assigner.first_name : "A Netball America administrator" %> has assigned the following sponsorship opportunity to you:</p>

    <div style="margin:20px 0;padding:16px;border-left:4px solid #173b73;background:#f3f6fa;">
      <p style="margin:0 0 8px;font-size:18px;font-weight:bold;"><%= @opportunity.sponsor.company_name %></p>
      <p style="margin:0 0 8px;"><strong>Opportunity type:</strong> <%= @opportunity.opportunity_type.presence || "—" %></p>
      <p style="margin:0 0 8px;"><strong>Status:</strong> <%= @opportunity.status.presence || "—" %></p>
      <% if @opportunity.area.present? %>
        <p style="margin:0 0 8px;"><strong>Area:</strong> <%= @opportunity.area %></p>
      <% end %>
      <% if @opportunity.date_submitted.present? %>
        <p style="margin:0 0 8px;"><strong>Date submitted:</strong> <%= @opportunity.date_submitted.to_fs(:long) %></p>
      <% end %>
      <% if @opportunity.amount.present? %>
        <p style="margin:0;"><strong>Amount:</strong> <%= number_to_currency(@opportunity.amount) %></p>
      <% end %>
    </div>

    <p style="margin:28px 0;text-align:center;">
      <%= link_to "View opportunity", edit_sponsor_opportunity_url(@opportunity.sponsor, @opportunity), style: "display:inline-block;border-radius:6px;background:#173b73;color:#ffffff;padding:12px 22px;text-decoration:none;font-weight:bold;" %>
    </p>

    <p>Regards,<br>Netball America</p>
  </div>
</div>
